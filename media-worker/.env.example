# Required: must match the MEDIA_WORKER_SHARED_SECRET stored in the app's backend secrets.
MEDIA_WORKER_SHARED_SECRET=

# Optional tuning
PORT=8080
# Renders and other video encodes, and quick tasks (probes, thumbnails, frames, audio), each run this many at once.
HEAVY_CONCURRENCY=2
QUICK_CONCURRENCY=2
# A render's clips not joined to the one before are made this many at a time (default 2 with 4+ CPUs, else 1).
CLIP_PARALLELISM=2
MAX_QUEUE_DEPTH=50
TASK_TIMEOUT_SECONDS=900
RENDER_TIMEOUT_SECONDS=43200
RENDER_STALL_SECONDS=1200
# Exit after this many seconds with nothing to do, so a host that starts it on demand (Fly) can stop its machine. 0: keep running.
IDLE_STOP_SECONDS=0
MAX_DOWNLOAD_MB=1024
MAX_TASK_DOWNLOAD_MB=2048
MAX_TASK_WORKSPACE_MB=4096
MAX_OUTPUT_MB=2048
SIGNATURE_WINDOW_SECONDS=300
HEARTBEAT_SECONDS=60

# Hosts the worker may download from / upload to (suffix match, https only).
ALLOWED_HOST_SUFFIXES=supabase.co,supabase.in,higgsfield.ai,cloudfront.net,amazonaws.com

# Hosts the worker may send signed result callbacks to (the app). Add a custom domain here if the app uses one.
CALLBACK_HOST_SUFFIXES=lovable.app,lovableproject.com
